{
  "name": "japanese-hover-docs",
  "displayName": "Japanese Hover Docs",
  "description": "HTML・CSS・JavaScriptの用語にカーソルを当てると日本語解説が表示されます",
  "version": "0.6.0",
  "publisher": "kiroworks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiroworks/japanese-hover-docs"
  },
  "homepage": "https://kiroworks.com/tools/japanese-hover-docs",
  "bugs": {
    "url": "https://github.com/kiroworks/japanese-hover-docs/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "japanese",
    "日本語",
    "hover",
    "docs",
    "html",
    "css",
    "javascript",
    "初心者",
    "beginner"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Japanese Hover Docs",
      "properties": {
        "japaneseHoverDocs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Japanese Hover Docsの解説表示を有効にする"
        },
        "japaneseHoverDocs.sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "用途",
              "構文",
              "関連",
              "注意",
              "エラー"
            ]
          },
          "default": [
            "用途",
            "構文",
            "関連",
            "注意",
            "エラー"
          ],
          "description": "ホバーパネルに表示するセクションを選択します"
        },
        "japaneseHoverDocs.sectionOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "用途",
              "構文",
              "関連",
              "注意",
              "エラー"
            ]
          },
          "default": [
            "用途",
            "構文",
            "関連",
            "注意",
            "エラー"
          ],
          "description": "ホバーパネルのセクションの表示順を指定します"
        }
      }
    }
  },
  "scripts": {
    "validate": "node ../scripts/validate-terms.js",
    "build:terms": "node ../scripts/build-terms.js",
    "build:site": "node ../scripts/build-site.js",
    "build": "npm run validate && npm run build:terms && tsc -p ./ && npm run build:site",
    "watch": "npm run build:terms && tsc -watch -p ./",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  },
  "icon": "icon.png"
}